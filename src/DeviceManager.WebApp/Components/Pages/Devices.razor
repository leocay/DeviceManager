@page "/devices"
@inject DeviceManager.WebApp.Services.DeviceApiClient DeviceApiClient
@inject DeviceManager.WebApp.Services.AuthSessionState AuthSessionState
@inject NavigationManager NavigationManager
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Device Inventory - AssetCentral</PageTitle>

<main class="inventory-shell">
    <header class="topbar">
        <div class="topbar-left">
            <button type="button" class="icon-btn" title="Thông báo">
                <span class="material-symbols-outlined">notifications</span>
            </button>
            <button type="button" class="icon-btn" title="Trợ giúp">
                <span class="material-symbols-outlined">help</span>
            </button>
        </div>
        <div class="topbar-user">
            <div class="topbar-user-info">
                <span class="topbar-name">@(string.IsNullOrWhiteSpace(AuthSessionState.FullName) ? "Administrator" : AuthSessionState.FullName)</span>
                <span class="topbar-role">Administrator</span>
            </div>
            <span class="avatar">A</span>
        </div>
    </header>

    <section class="inventory-wrapper">
        <header class="inventory-header">
            <div>
                <h1>Danh sách thiết bị</h1>
                <p>Quản lý và theo dõi @(_totalCount.ToString("N0")) tài sản thiết bị trong toàn hệ thống.</p>
            </div>
            <button type="button" class="add-device-btn" title="Thêm thiết bị mới">
                <span class="material-symbols-outlined">add</span>
                <span>Thêm thiết bị mới</span>
            </button>
        </header>

        <section class="inventory-filters">
            <div class="search-wrap">
                <span class="material-symbols-outlined">search</span>
                <input @bind="_searchTerm" @bind:event="oninput" @bind:after="OnFilterChangedAsync" placeholder="Tìm kiếm theo tên hoặc số serial..." />
            </div>

            <select @bind="_selectedCategory" @bind:after="OnFilterChangedAsync">
                @foreach (var category in _categoryOptions)
                {
                    <option value="@category.Value">Loại thiết bị: @category.Label</option>
                }
            </select>

            <select @bind="_selectedStatus" @bind:after="OnFilterChangedAsync">
                @foreach (var status in _statusOptions)
                {
                    <option value="@status.Value">Trạng thái: @status.Label</option>
                }
            </select>

            <button type="button" class="clear-filter-btn" @onclick="ClearFiltersAsync">Xóa bộ lọc</button>
        </section>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="status-banner error">@_errorMessage</div>
        }

        @if (_loading)
        {
            <p>Đang tải dữ liệu...</p>
        }
        else if (_devices.Count == 0)
        {
            <p>Không có dữ liệu thiết bị.</p>
        }
        else
        {
            <div class="inventory-table-wrap">
                <table class="inventory-table">
                    <thead>
                        <tr>
                            <th>Tên thiết bị</th>
                            <th>Loại</th>
                            <th>Số serial</th>
                            <th>Trạng thái</th>
                            <th class="text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var device in _devices)
                        {
                            <tr>
                                <td>
                                    <div class="device-main">@device.DeviceName</div>
                                    <div class="device-sub">@GetDeviceDescription(device)</div>
                                </td>
                                <td><span class="chip">@device.CategoryName</span></td>
                                <td>@(device.SerialNumber ?? "-")</td>
                                <td>
                                    <span class="status-pill @GetStatusClass(device.Status)">@GetStatusLabel(device.Status)</span>
                                </td>
                                <td class="text-right">
                                    <div class="row-actions">
                                        <button type="button" class="action-btn" title="Xem chi tiết">
                                            <span class="material-symbols-outlined">visibility</span>
                                        </button>
                                        <button type="button" class="action-btn" title="Chỉnh sửa">
                                            <span class="material-symbols-outlined">edit</span>
                                        </button>
                                        <button type="button" class="action-btn" title="Xóa">
                                            <span class="material-symbols-outlined">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <footer class="inventory-footer">
                <span>Hiển thị @GetDisplayRangeText() thiết bị</span>
                <div class="pager-actions" aria-label="Phân trang">
                    <button type="button" class="pager-nav" @onclick="PreviousPageAsync" disabled="@(_pageNumber <= 1 || _loading)">
                        <span class="material-symbols-outlined">chevron_left</span>
                    </button>
                    @foreach (var pageNumberOption in GetVisiblePages())
                    {
                        <button type="button" class="pager-page @(pageNumberOption == _pageNumber ? "active" : string.Empty)" @onclick="() => GoToPageAsync(pageNumberOption)">
                            @pageNumberOption
                        </button>
                    }
                    <button type="button" class="pager-nav" @onclick="NextPageAsync" disabled="@(_pageNumber >= _totalPages || _loading)">
                        <span class="material-symbols-outlined">chevron_right</span>
                    </button>
                </div>
            </footer>
        }
    </section>
</main>

@code {
    private List<DeviceManager.Contracts.Device.DeviceDto> _devices = new();
    private bool _loading;
    private string? _errorMessage;
    private string? _searchTerm;
    private string _selectedCategory = string.Empty;
    private string _selectedStatus = string.Empty;
    private int _pageNumber = 1;
    private const int PageSize = 4;
    private int _totalCount;
    private int _totalPages = 1;
    private readonly List<FilterOption> _categoryOptions =
    [
        new(string.Empty, "Tất cả"),
        new("1", "Laptop"),
        new("2", "Desktop"),
        new("3", "Monitor"),
        new("4", "Printer"),
        new("5", "Scanner"),
        new("6", "Projector"),
        new("7", "Network Switch"),
        new("8", "Router"),
        new("9", "WiFi Access Point"),
        new("10", "UPS"),
        new("11", "Server"),
        new("12", "Keyboard"),
        new("13", "Mouse"),
        new("14", "Docking Station"),
        new("15", "Tablet"),
        new("16", "Smartphone"),
        new("17", "Headset"),
        new("18", "Webcam"),
        new("19", "SSD"),
        new("20", "HDD")
    ];
    private readonly List<FilterOption> _statusOptions =
    [
        new(string.Empty, "Tất cả"),
        new("Available", "Mới"),
        new("In Use", "Đang sử dụng"),
        new("Maintenance", "Bảo trì"),
        new("Reserved", "Đã đặt trước"),
        new("Retired", "Hỏng")
    ];

    protected override async Task OnInitializedAsync()
    {
        if (!AuthSessionState.IsAuthenticated)
        {
            var token = HttpContextAccessor.HttpContext?.Session.GetString("AccessToken");
            var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName");

            if (!string.IsNullOrWhiteSpace(token))
            {
                AuthSessionState.AccessToken = token;
                AuthSessionState.FullName = fullName;
            }
        }

        if (!AuthSessionState.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        await LoadDevicesAsync();
    }

    private async Task LoadDevicesAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            var response = await DeviceApiClient.GetDevicesAsync(
                _searchTerm,
                categoryId: _selectedCategory,
                status: _selectedStatus,
                pageNumber: _pageNumber,
                pageSize: PageSize);

            if (response is null)
            {
                _errorMessage = "Không tải được danh sách thiết bị. Vui lòng đăng nhập lại.";
                return;
            }

            _devices = response.Devices;
            _totalCount = response.TotalCount;
            _totalPages = Math.Max(response.TotalPages, 1);
        }
        catch
        {
            _errorMessage = "Có lỗi khi tải danh sách thiết bị.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (_pageNumber <= 1)
        {
            return;
        }

        _pageNumber--;
        await LoadDevicesAsync();
    }

    private async Task NextPageAsync()
    {
        if (_pageNumber >= _totalPages)
        {
            return;
        }

        _pageNumber++;
        await LoadDevicesAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || page > _totalPages || page == _pageNumber)
        {
            return;
        }

        _pageNumber = page;
        await LoadDevicesAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _searchTerm = null;
        _selectedCategory = string.Empty;
        _selectedStatus = string.Empty;
        _pageNumber = 1;
        await LoadDevicesAsync();
    }

    private async Task OnFilterChangedAsync()
    {
        _pageNumber = 1;
        await LoadDevicesAsync();
    }

    private string GetDisplayRangeText()
    {
        if (_totalCount == 0)
        {
            return "0 của 0";
        }

        var start = ((_pageNumber - 1) * PageSize) + 1;
        var end = Math.Min(_pageNumber * PageSize, _totalCount);
        return $"{start}-{end} của {_totalCount:N0}";
    }

    private IEnumerable<int> GetVisiblePages()
    {
        const int maxPages = 3;

        if (_totalPages <= maxPages)
        {
            return Enumerable.Range(1, _totalPages);
        }

        var start = Math.Max(1, _pageNumber - 1);
        if (start + maxPages - 1 > _totalPages)
        {
            start = _totalPages - maxPages + 1;
        }

        return Enumerable.Range(start, maxPages);
    }

    private static string GetStatusLabel(string? status) => status switch
    {
        "Available" => "Mới",
        "In Use" => "Đang sử dụng",
        "Maintenance" => "Bảo trì",
        "Reserved" => "Đã đặt trước",
        "Retired" => "Hỏng",
        _ => string.IsNullOrWhiteSpace(status) ? "Không rõ" : status
    };

    private static string GetStatusClass(string? status) => status switch
    {
        "Available" => "is-new",
        "In Use" => "is-active",
        "Maintenance" => "is-maintenance",
        "Reserved" => "is-reserved",
        "Retired" => "is-retired",
        _ => "is-default"
    };

    private static string GetDeviceDescription(DeviceManager.Contracts.Device.DeviceDto device)
    {
        if (!string.IsNullOrWhiteSpace(device.Brand) && !string.IsNullOrWhiteSpace(device.Model))
        {
            return $"{device.Brand} {device.Model}";
        }

        return "Thiết bị công nghệ";
    }

    private sealed record FilterOption(string Value, string Label);
}
