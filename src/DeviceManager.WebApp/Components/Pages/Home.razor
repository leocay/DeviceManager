@page "/"
@inject DeviceManager.WebApp.Services.AuthApiClient AuthApiClient
@inject DeviceManager.WebApp.Services.AuthSessionState AuthSessionState
@inject NavigationManager NavigationManager
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>AssetCentral - Dang nhap quan tri vien</PageTitle>

<main class="login-shell">
	<section class="login-wrapper">
		<header class="brand-header">
			<h1 class="brand-title">AssetCentral</h1>
			<p class="brand-subtitle">Admin Control Portal</p>
		</header>

		<article class="login-card">
			<header class="login-head">
				<h2>Dang nhap</h2>
				<p>Vui long nhap thong tin de truy cap he thong.</p>
			</header>

			@if (!string.IsNullOrWhiteSpace(_statusMessage))
			{
				<div class="status-banner @(_isError ? "error" : "ok")">@_statusMessage</div>
			}

			<EditForm Model="_model" OnValidSubmit="HandleSubmitAsync" FormName="LoginForm" method="post" class="login-form">
				<DataAnnotationsValidator />

				<div class="field-block">
					<label for="username">TEN DANG NHAP</label>
					<div class="input-wrap">
						<span class="material-symbols-outlined">person</span>
						<InputText id="username" @bind-Value="_model.Username" placeholder="admin" autocomplete="username" />
					</div>
					<ValidationMessage For="() => _model.Username" />
				</div>

				<div class="field-block">
					<label for="password">MAT KHAU</label>
					<div class="input-wrap">
						<span class="material-symbols-outlined">lock</span>
						<InputText id="password" @bind-Value="_model.Password" type="password" placeholder="••••••••" autocomplete="current-password" />
					</div>
					<ValidationMessage For="() => _model.Password" />
				</div>

				<label class="remember-row" for="remember">
					<InputCheckbox id="remember" @bind-Value="_model.RememberMe" />
					<span>Ghi nho thiet bi nay</span>
				</label>

				<button type="submit" class="login-btn" disabled="@_submitting">
					<span>@(_submitting ? "Dang xu ly..." : "Dang nhap")</span>
					<span class="material-symbols-outlined">login</span>
				</button>
			</EditForm>

			<footer class="login-foot">
				<p>Phien ban 2.4.0 - Enterprise Edition</p>
			</footer>
		</article>
	</section>
</main>

@code {
	[Microsoft.AspNetCore.Components.SupplyParameterFromForm(FormName = "LoginForm")]
	private LoginFormModel _model { get; set; } = new();
	private bool _submitting;
	private string? _statusMessage;
	private bool _isError;

	private async Task HandleSubmitAsync()
	{
		_submitting = true;
		_statusMessage = null;
		LoginResponse result;

		try
		{
			result = await AuthApiClient.LoginAsync(new LoginRequest
			{
				Username = _model.Username,
				Password = _model.Password,
				RememberMe = _model.RememberMe
			});
		}
		catch
		{
			_isError = true;
			_statusMessage = "Khong the ket noi backend. Hay kiem tra API da chay o cong cau hinh.";
			_submitting = false;
			return;
		}

		_isError = !result.Success;
		_statusMessage = result.Success
			? $"Xin chao {result.FullName}. Dang nhap thanh cong vao backend."
			: result.Message;

		if (result.Success)
		{
			AuthSessionState.AccessToken = result.AccessToken;
			AuthSessionState.FullName = result.FullName;
			HttpContextAccessor.HttpContext?.Session.SetString("AccessToken", result.AccessToken ?? string.Empty);
			HttpContextAccessor.HttpContext?.Session.SetString("FullName", result.FullName ?? string.Empty);
			NavigationManager.NavigateTo("/devices", forceLoad: true);
		}
		else
		{
			_submitting = false;
		}
	}

	private sealed class LoginFormModel
	{
		[System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Ten dang nhap la bat buoc.")]
		public string Username { get; set; } = string.Empty;

		[System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Mat khau la bat buoc.")]
		public string Password { get; set; } = string.Empty;

		public bool RememberMe { get; set; }
	}
}
