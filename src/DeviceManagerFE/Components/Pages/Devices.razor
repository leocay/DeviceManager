@page "/devices"
@inherits DevicesPageBase

<PageTitle>Danh sách thiết bị - AssetCentral</PageTitle>

<main class="inventory-shell">
    <header class="topbar">
        <div class="topbar-left">
            <button type="button" class="icon-btn" title="Thông báo">
                <span class="material-symbols-outlined">notifications</span>
            </button>
            <button type="button" class="icon-btn" title="Hỗ trợ">
                <span class="material-symbols-outlined">help</span>
            </button>
        </div>
        <div class="topbar-user">
            <div class="topbar-user-info">
                <span class="topbar-name">@DisplayName</span>
                <span class="topbar-role">Administrator</span>
            </div>
            <span class="avatar">@AvatarText</span>
        </div>
    </header>

    <section class="inventory-wrapper page-layout">
        <header class="strict-header">
            <div class="strict-header-main">
                <div class="strict-header-row strict-header-row-placeholder" aria-hidden="true"></div>
                <div class="strict-header-copy">
                    <h1 class="strict-title">Danh sách thiết bị</h1>
                    <p class="strict-subtitle">Quản lý và theo dõi @(TotalCount.ToString("N0")) tài sản thiết bị trong toàn hệ thống.</p>
                </div>
            </div>
            <div class="strict-header-actions">
                <button type="button" class="add-device-btn" title="Thêm thiết bị mới" @onclick="OpenCreateDevicePage">
                    <span class="material-symbols-outlined">add</span>
                    <span>Thêm thiết bị mới</span>
                </button>
            </div>
        </header>

        <section class="inventory-filters">
            <div class="search-wrap">
                <span class="material-symbols-outlined">search</span>
                <input value="@Query.SearchTerm" @oninput="OnSearchInputAsync" placeholder="Tìm theo mã nội bộ hoặc tên người dùng..." />
            </div>

            <select value="@Query.CategoryId" @onchange="OnCategoryChangedAsync">
                @foreach (var category in CategoryOptions)
                {
                    <option value="@category.Value">Loại thiết bị: @category.Label</option>
                }
            </select>

            <select value="@Query.Status" @onchange="OnStatusChangedAsync">
                @foreach (var status in StatusOptions)
                {
                    <option value="@status.Value">Trạng thái: @status.Label</option>
                }
            </select>

            <button type="button" class="clear-filter-btn" @onclick="ClearFiltersAsync">Xóa bộ lọc</button>
        </section>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="status-banner error">@ErrorMessage</div>
        }

        @if (Loading)
        {
            <p>Đang tải dữ liệu...</p>
        }
        else if (Devices.Count == 0)
        {
            <p>Không có dữ liệu thiết bị.</p>
        }
        else
        {
            <div class="inventory-table-wrap">
                <table class="inventory-table">
                    <thead>
                        <tr>
                            <th>Mã nội bộ</th>
                            <th>Loại</th>
                            <th>Người sử dụng</th>
                            <th>Trạng thái</th>
                            <th class="text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var device in Devices)
                        {
                            <tr>
                                <td>
                                    <div class="device-main">@device.DeviceCode</div>
                                </td>
                                <td><span class="chip">@device.CategoryName</span></td>
                                <td>@(device.EmployeeName ?? "-")</td>
                                <td>
                                    <span class="status-pill @device.StatusCssClass">@device.StatusLabel</span>
                                </td>
                                <td class="text-right">
                                    <div class="row-actions">
                                        <button type="button" class="action-btn" title="Xem chi tiết">
                                            <span class="material-symbols-outlined">visibility</span>
                                        </button>
                                        <button type="button" class="action-btn" title="Chỉnh sửa" @onclick="() => OpenEditDevicePage(device.DeviceId)">
                                            <span class="material-symbols-outlined">edit</span>
                                        </button>
                                        <button type="button" class="action-btn" title="Xóa">
                                            <span class="material-symbols-outlined">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <footer class="inventory-footer">
                <span>Hiển thị @GetDisplayRangeText() thiết bị</span>
                <div class="pager-actions" aria-label="Phân trang">
                    <button type="button" class="pager-nav" @onclick="PreviousPageAsync" disabled="@(Query.PageNumber <= 1 || Loading)">
                        <span class="material-symbols-outlined">chevron_left</span>
                    </button>
                    @foreach (var pageNumberOption in GetVisiblePages())
                    {
                        <button type="button" class="pager-page @(pageNumberOption == Query.PageNumber ? "active" : string.Empty)" @onclick="() => GoToPageAsync(pageNumberOption)">
                            @pageNumberOption
                        </button>
                    }
                    <button type="button" class="pager-nav" @onclick="NextPageAsync" disabled="@(Query.PageNumber >= TotalPages || Loading)">
                        <span class="material-symbols-outlined">chevron_right</span>
                    </button>
                </div>
            </footer>
        }
    </section>
</main>
