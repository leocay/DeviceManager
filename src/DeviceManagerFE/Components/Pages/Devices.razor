@page "/devices"
@inherits DevicesPageBase

<PageTitle>Device Inventory - AssetCentral</PageTitle>

<main class="inventory-shell">
    <header class="topbar">
        <div class="topbar-left">
            <button type="button" class="icon-btn" title="Thong bao">
                <span class="material-symbols-outlined">notifications</span>
            </button>
            <button type="button" class="icon-btn" title="Ho tro">
                <span class="material-symbols-outlined">help</span>
            </button>
        </div>
        <div class="topbar-user">
            <div class="topbar-user-info">
                <span class="topbar-name">@DisplayName</span>
                <span class="topbar-role">Administrator</span>
            </div>
            <span class="avatar">@AvatarText</span>
        </div>
    </header>

    <section class="inventory-wrapper">
        <header class="inventory-header">
            <div>
                <h1>Danh sach thiet bi</h1>
                <p>Quan ly va theo doi @(TotalCount.ToString("N0")) tai san thiet bi trong toan he thong.</p>
            </div>
            <button type="button" class="add-device-btn" title="Them thiet bi moi" @onclick="OpenCreateDevicePage">
                <span class="material-symbols-outlined">add</span>
                <span>Them thiet bi moi</span>
            </button>
        </header>

        <section class="inventory-filters">
            <div class="search-wrap">
                <span class="material-symbols-outlined">search</span>
                <input value="@Query.SearchTerm" @oninput="OnSearchInputAsync" placeholder="Tim kiem theo ten hoac so serial..." />
            </div>

            <select value="@Query.CategoryId" @onchange="OnCategoryChangedAsync">
                @foreach (var category in CategoryOptions)
                {
                    <option value="@category.Value">Loai thiet bi: @category.Label</option>
                }
            </select>

            <select value="@Query.Status" @onchange="OnStatusChangedAsync">
                @foreach (var status in StatusOptions)
                {
                    <option value="@status.Value">Trang thai: @status.Label</option>
                }
            </select>

            <button type="button" class="clear-filter-btn" @onclick="ClearFiltersAsync">Xoa bo loc</button>
        </section>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="status-banner error">@ErrorMessage</div>
        }

        @if (Loading)
        {
            <p>Dang tai du lieu...</p>
        }
        else if (Devices.Count == 0)
        {
            <p>Khong co du lieu thiet bi.</p>
        }
        else
        {
            <div class="inventory-table-wrap">
                <table class="inventory-table">
                    <thead>
                        <tr>
                            <th>Ten thiet bi</th>
                            <th>Loai</th>
                            <th>So serial</th>
                            <th>Trang thai</th>
                            <th class="text-right">Thao tac</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var device in Devices)
                        {
                            <tr>
                                <td>
                                    <div class="device-main">@device.DeviceName</div>
                                    <div class="device-sub">@device.Description</div>
                                </td>
                                <td><span class="chip">@device.CategoryName</span></td>
                                <td>@(device.SerialNumber ?? "-")</td>
                                <td>
                                    <span class="status-pill @device.StatusCssClass">@device.StatusLabel</span>
                                </td>
                                <td class="text-right">
                                    <div class="row-actions">
                                        <button type="button" class="action-btn" title="Xem chi tiet">
                                            <span class="material-symbols-outlined">visibility</span>
                                        </button>
                                        <button type="button" class="action-btn" title="Chinh sua">
                                            <span class="material-symbols-outlined">edit</span>
                                        </button>
                                        <button type="button" class="action-btn" title="Xoa">
                                            <span class="material-symbols-outlined">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <footer class="inventory-footer">
                <span>Hien thi @GetDisplayRangeText() thiet bi</span>
                <div class="pager-actions" aria-label="Phan trang">
                    <button type="button" class="pager-nav" @onclick="PreviousPageAsync" disabled="@(Query.PageNumber <= 1 || Loading)">
                        <span class="material-symbols-outlined">chevron_left</span>
                    </button>
                    @foreach (var pageNumberOption in GetVisiblePages())
                    {
                        <button type="button" class="pager-page @(pageNumberOption == Query.PageNumber ? "active" : string.Empty)" @onclick="() => GoToPageAsync(pageNumberOption)">
                            @pageNumberOption
                        </button>
                    }
                    <button type="button" class="pager-nav" @onclick="NextPageAsync" disabled="@(Query.PageNumber >= TotalPages || Loading)">
                        <span class="material-symbols-outlined">chevron_right</span>
                    </button>
                </div>
            </footer>
        }
    </section>
</main>
