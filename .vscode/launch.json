{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend API",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/DeviceManagerBE/DeviceManagerBE.csproj",
        "--no-build"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "preLaunchTask": "build-all"
    },
    {
      "name": "Debug Frontend Blazor",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/DeviceManagerFE/DeviceManagerFE.csproj",
        "--no-build"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      }
    }
  ],
  "compounds": [
    {
      "name": "Run BE + FE",
      "configurations": [
        "Debug Backend API",
        "Debug Frontend Blazor"
      ],
      "stopAll": true
    }
  ]
}
