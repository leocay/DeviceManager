{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "free-debug-ports",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/free-debug-ports.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "build-all",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "src/src.sln"
      ],
      "dependsOn": [
        "free-debug-ports"
      ],
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "run-api",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--launch-profile",
        "http",
        "--project",
        "src/DeviceManager.Api/DeviceManager.Api.csproj"
      ],
      "isBackground": true,
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "run-webapp",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/DeviceManager.WebApp/DeviceManager.WebApp.csproj"
      ],
      "isBackground": true,
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "run-all",
      "dependsOn": [
        "run-api",
        "run-webapp"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
